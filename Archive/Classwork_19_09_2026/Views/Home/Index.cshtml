@model Classwork_19_09_2026.Models.PersonViewModel;

@{
    ViewData["Title"] = "First project MVC ";
}

<div class="container mt-4">
    <div class="alert alert-info">
        <h4>@Model.Message</h4>
    </div>

    <div class="card p-4 shadow-sm">
        <h3>Check your age</h3>
        <form asp-controller="Home" asp-action="Index" method="post" class="mt-4">
            <div class="mb-3">
                <label for="Name" class="form-labe}-">Your name: </label>
                <input type="text" class="form-control" id="Name" name="Name" placeholder="Input your name"/>
            </div>

            <div class="mb-3">
                <label for="BirthYear" class="form-labe}-">Birth Year: </label>
                <input type="number" class="form-control" id="BirthYear" name="BirthYear" placeholder="Input your birth year" />
            </div>
            <button type="submit" class="btn btn-primary">Submit(Send)</button>
        </form>
        @if (string.IsNullOrEmpty(Model.AgeResult))
        {
            <div class="mt-4 alert alert-success">
                <p>@Model.AgeResult</p>
            </div>
        }
    </div>

</div>